# Cloudflare credentials (for wrangler / D1 / Pages deploys)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Kakao Maps JS SDK key (client-exposed). 전각 안내·찾아오는 길 지도에 사용.
# PUBLIC_ 접두어가 있어야 Astro가 클라이언트 코드에 노출(import.meta.env.PUBLIC_KAKAO_JS_KEY).
# https://developers.kakao.com 에서 발급 + 사이트 도메인 등록
# (https://jsbeob.com, http://localhost:4321). 키 없이도 빌드는 통과하며,
# 지도 영역엔 "키 미설정" 안내가 대신 표시됨.
PUBLIC_KAKAO_JS_KEY=
