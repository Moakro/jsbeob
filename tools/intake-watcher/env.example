# 올림함 AI 감시 서비스 설정 — ~/.config/jsbeob-intake-watcher/env 로 복사해 고친다 (git 밖)
# systemd 는 이 파일을 EnvironmentFile 로 읽는다(따옴표 없이 KEY=값).

# 사이트 주소 — /api/* 가 API Worker 로 넘어간다. 로컬 시험은 http://localhost:<API 포트>
INTAKE_API_BASE=https://jsbeob.com
# 감시 서비스 전용 열쇠 파일(한 줄, 권한 600). API Worker 비밀값 INTAKE_WORKER_TOKEN 과 같은 값
INTAKE_TOKEN_FILE=/home/azgian/.config/jsbeob-intake-watcher/token

# AI 부르는 방식 — claude-cli: 오너 구독 Claude Code(`claude -p`). 나중에 API 키 방식을 더하면 여기서 바꾼다
INTAKE_EXTRACTOR=claude-cli
INTAKE_MODEL=claude-opus-5-5
# (선택) claude 생각 깊이: low | medium | high
#INTAKE_EFFORT=medium

INTAKE_POLL_SECONDS=30
INTAKE_TIMEOUT_SECONDS=300
INTAKE_MAX_PER_DAY=30
# 원본을 잠깐 받아 두는 곳(한 건 끝나면 지움). 비우면 /tmp
INTAKE_WORK_DIR=/home/azgian/.cache/jsbeob-intake

# systemd 사용자 서비스에는 nvm 경로가 없으므로 node·claude 가 있는 곳을 넣는다
PATH=/home/azgian/.nvm/versions/node/v24.15.0/bin:/home/azgian/.local/bin:/usr/local/bin:/usr/bin:/bin
