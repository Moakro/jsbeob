{
  "name": "jsbeob",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "node scripts/dev.mjs site",
    "dev:api": "node scripts/dev.mjs api",
    "dev:login": "node scripts/dev-login.mjs",
    "test:intake": "node scripts/test-intake.mjs",
    "library:sync": "node scripts/library-sync.mjs",
    "test:library-sync": "node scripts/test-library-sync.mjs",
    "library:export-scripture": "node scripts/library-export-scripture.mjs",
    "setup:worktree": "bash scripts/worktree-setup.sh",
    "db:local:init": "cd jsbeob-api && wrangler d1 execute jsbeob-db --local -c wrangler.toml --file=schema.sql",
    "build": "astro build",
    "preview": "pnpm run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.3.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/svelte": "^8.0.5",
    "@ohah/hwpjs": "0.1.2",
    "astro": "^6.1.9",
    "korean-lunar-calendar": "^0.3.6",
    "marked": "^18.0.2",
    "svelte": "^5.55.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "pagefind": "^1.5.2",
    "sharp": "0.34.5",
    "wrangler": "^4.88.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
