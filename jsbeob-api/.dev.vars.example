# 로컬 wrangler dev 용 시크릿 (이 파일을 .dev.vars 로 복사 후 채움)
# .dev.vars 는 gitignore 됨.

AUTH_SECRET="여기에-32자-이상-랜덤-문자열"

# 카카오 (메인)
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""   # 보안 강화 사용 시에만

# 구글 (보조)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 사이트·업로드
SITE_ORIGIN="http://localhost:4321"
UPLOADS_PUBLIC_BASE=""

# 유튜브 채널 영상 목록(미디어 페이지)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# 올림함 AI 초안 — 미니PC 감시 서비스(tools/intake-watcher) 전용 열쇠, 32자 이상 (없으면 AI 초안 꺼짐)
# 만들기: openssl rand -hex 32   — 같은 값을 감시 서비스의 열쇠 파일(INTAKE_TOKEN_FILE)에 넣는다
INTAKE_WORKER_TOKEN=""

# 공용 자료실 → 사진 창고 동기화 도구(scripts/library-sync.mjs) 전용 열쇠, 32자 이상 (없으면 /api/library-sync/* 404)
# 만들기: openssl rand -hex 32   — 같은 값을 ~/.config/jsbeob-library-sync/token(권한 600)에 넣는다
LIBRARY_SYNC_TOKEN=""
