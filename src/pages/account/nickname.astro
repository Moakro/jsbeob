---
import Base from "../../layouts/Base.astro";
import NicknameForm from "../../components/NicknameForm.svelte";
export const prerender = false;
---

<Base title="닉네임 설정">
  <div class="wrap">
    <h1>닉네임 설정</h1>
    <p class="sub">게시판에 글·댓글을 쓰려면 닉네임이 필요합니다.</p>
    <NicknameForm client:load />
  </div>
</Base>

<style>
  .wrap {
    max-width: 480px;
    margin-inline: auto;
  }
  h1 {
    font-size: 1.8rem;
    margin-bottom: 6px;
  }
  .sub {
    color: var(--color-muted);
    margin-bottom: 24px;
  }
</style>
