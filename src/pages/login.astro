---
import Base from "../layouts/Base.astro";
import LoginPanel from "../components/LoginPanel.svelte";
export const prerender = false;
---

<Base title="로그인">
  <div class="login-wrap">
    <div class="brand-mark">甑山</div>
    <h1>증산법종교 로그인</h1>
    <p class="sub">카카오 또는 구글 계정으로 로그인하세요.</p>
    <LoginPanel client:load />
  </div>
</Base>

<style>
  .login-wrap {
    max-width: 380px;
    margin: 40px auto;
    text-align: center;
  }
  .brand-mark {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    display: grid;
    place-items: center;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.4rem;
    border-radius: 12px;
  }
  h1 {
    font-size: 1.6rem;
    margin: 0 0 6px;
  }
  .sub {
    color: var(--color-muted);
    margin: 0 0 24px;
  }
</style>
