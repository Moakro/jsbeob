---
import Base from "../layouts/Base.astro";
import LoginPanel from "../components/LoginPanel.svelte";
export const prerender = false;
---

<Base title="로그인">
  <div class="login-wrap">
    <svg class="brand-mark" viewBox="0 0 100 100" aria-hidden="true">
      <circle cx="50" cy="50" r="43.25" fill="none" stroke="currentColor" stroke-width="13.5"></circle>
      <path d="M43.25 8h13.5v84h-13.5zM8 43.25h84v13.5H8z" fill="currentColor"></path>
    </svg>
    <h1>증산법종교 로그인</h1>
    <p class="sub">카카오 또는 구글 계정으로 로그인하세요.</p>
    <LoginPanel client:load />
  </div>
</Base>

<style>
  .login-wrap {
    max-width: 380px;
    margin: 40px auto;
    text-align: center;
  }
  .brand-mark {
    display: block;
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    color: var(--color-primary);
  }
  h1 {
    font-size: 1.6rem;
    margin: 0 0 6px;
  }
  .sub {
    color: var(--color-muted);
    margin: 0 0 24px;
  }
</style>
