---
import Base from "../../layouts/Base.astro";
import { ABOUT_KINDS } from "../../lib/content-types";
import { getArticle, listArticles, listBranches } from "../../lib/content";
import AboutSubnav from "../../components/content/AboutSubnav.astro";
import AdminEditLink from "../../components/content/AdminEditLink.astro";
import ContentGallery from "../../components/content/ContentGallery.astro";
import DocPager from "../../components/content/DocPager.astro";
import LeadImage from "../../components/content/LeadImage.astro";
import PageTitle from "../../components/content/PageTitle.astro";
import PreviewNotice from "../../components/content/PreviewNotice.astro";
import Prose from "../../components/content/Prose.astro";
import SideList from "../../components/content/SideList.astro";
import BranchList from "../../components/content/BranchList.astro";
export const prerender = false;
const preview = Astro.url.searchParams.get("preview") === "1";
const entry = await getArticle(Astro.request, "about", Astro.params.slug, preview);
if (!entry)
  return new Response("페이지를 찾을 수 없습니다.", {
    status: 404,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  });
const all = await listArticles(Astro.request, "about");
// 지부·분원 글: 본문(소개 문구) 아래에 지부·분원 표를 카드로 붙인다 (2026-11-06)
const isBranches = entry.kind === "branches";
const branches = isBranches ? await listBranches(Astro.request) : [];
// 지부·분원 페이지의 "편집"은 지부·분원 관리 탭으로(소개 문구는 관리 목록의 '소개 글 편집')
const editHref = isBranches ? "/admin/#branches" : `/admin/#article/${entry.id}`;
const { title, title_hanja, summary, hero, gallery = [], body_html = "", status, id } = entry;
const href = (slug) => `/about/${slug}/`;
const side = all
  .filter((a) => a.kind === entry.kind)
  .map((a) => ({
    key: a.slug,
    title: a.title,
    hanja: a.title_hanja,
    href: href(a.slug),
    on: a.slug === entry.slug,
    draft: a.status === "draft",
  }));
if (side.length && !side.some((s) => s.on))
  side.unshift({ key: entry.slug, title, hanja: title_hanja, href: href(entry.slug), on: true });
const split = side.length > 1;
const at = side.findIndex((s) => s.on);
const prev = split && at > 0 ? { href: side[at - 1].href, label: side[at - 1].title } : null;
const next =
  split && at >= 0 && at < side.length - 1 ? { href: side[at + 1].href, label: side[at + 1].title } : null;
const listLabel = `${ABOUT_KINDS[entry.kind] ?? "소개"} 목록`;
---

<Base title={title} description={summary ?? void 0} tight>
  {" "}
  <PreviewNotice status={status} editHref={editHref} />{" "}
  {status === "published" && (
    <div hidden data-page-feed data-kind="article" data-id={id} data-title={title}></div>
  )}
  <AboutSubnav articles={all} current={entry.kind} />
  <div class:list={[{ "doc-split": split }]}>
    <div class="doc-main">
      <article class="doc">
        <PageTitle title={title} hanja={title_hanja}><AdminEditLink href={editHref} inline /></PageTitle>{" "}
        {summary && <p class="summary">{summary}</p>} <LeadImage image={hero} alt={title} />{" "}
        {/* 지부·분원: 카드 목록을 본문보다 먼저 — 본문에는 청장년회·여성회 같은 기관 안내만 남긴다 */}
        {branches.length > 0 && <BranchList items={branches} />}
        <Prose html={body_html} /> <ContentGallery items={gallery} fallbackAlt={title} />
      </article>
    </div>
    {split && <SideList label={listLabel} items={side} />}
  </div>
  {split && <DocPager prev={prev} next={next} />}
</Base>

<style>
  .doc {
    max-width: 760px;
  }
  .summary {
    margin: 0 0 1.4em;
    color: var(--color-muted);
  }
</style>
