---
// 옛 홈페이지 보관함 — 글 보기 (읽기 전용, 2026-11-12)
import Base from "../../../layouts/Base.astro";
import LegacyHead from "../../../components/legacy/LegacyHead.astro";
import Prose from "../../../components/content/Prose.astro";
import LegacySide from "../../../components/legacy/LegacySide.astro";
import LegacySubTitle from "../../../components/legacy/LegacySubTitle.astro";
import SubTabs from "../../../components/content/SubTabs.astro";
import {
  getLegacy,
  legacyCategories,
  legacyHref,
  legacyGroups,
  legacyBoardName,
  legacyListHref,
} from "../../../lib/content";
export const prerender = false;

const { board, cid } = Astro.params;
const valid = /^[a-z]+$/.test(board ?? "") && /^\d+$/.test(cid ?? "");
// lp: 아래 목록의 쪽(없으면 지금 글이 든 쪽)
const lp = parseInt(Astro.url.searchParams.get("lp") ?? "", 10) || undefined;
// cat: 글을 연 목록의 분류(분류 탭에서 열었을 때). 없으면 게시판 전체에서 연 것 — 글의 분류로 좁히지 않는다 (사용자 지시 2026-11-14)
const catParam = (Astro.url.searchParams.get("cat") ?? "").trim().slice(0, 40);
const [data, cats] = valid
  ? await Promise.all([getLegacy(Astro.request, board!, cid!, lp, catParam || undefined), legacyCategories(Astro.request)])
  : [null, []];
if (!data)
  return new Response("글을 찾을 수 없습니다.", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
const { post, comments, list } = data;
// 실제로 적용된 범위(API 가 그 글의 분류가 아닌 cat 은 무시한다)
const ctx: string = list.category ?? "";
const md = (s: string | null) => (s ? s.slice(5, 10) : ""); // 옛 사이트처럼 월-일
const lpHref = (n: number) => {
  const sp = new URLSearchParams();
  if (ctx) sp.set("cat", ctx);
  if (n !== list.own) sp.set("lp", String(n));
  const qs = sp.toString();
  return `/legacy/${post.board}/${post.cid}/${qs ? `?${qs}` : ""}#legacy-list`;
};
const groups = legacyGroups(cats);
const g = groups.find((x) => x.board === post.board);
const fmt = (s: string | null) => (s ? s.replace(/-/g, ".") : "");
const n = (v: number) => Number(v).toLocaleString("ko-KR");
// 머리: 목록과 같은 모양 — 게시판 이름(글 수) + 분류 탭(전체 + 분류). 켜진 탭 = 글을 연 범위. 탭은 그 목록으로 간다.
const boardName = legacyBoardName(post.board);
const boardHref = legacyListHref({ board: post.board });
const tabs = g
  ? [
      { label: "전체", href: boardHref, on: !ctx, count: n(g.n) },
      ...g.cats.map((c) => ({ label: c.category, href: legacyListHref({ board: post.board, category: c.category }), on: c.category === ctx, count: n(c.n) })),
    ]
  : [];
// 아래 목록 머리: 게시판(» 분류) — 각각 그 목록으로
const crumbs = [{ label: boardName, href: boardHref }, ...(ctx ? [{ label: ctx, href: legacyListHref({ board: post.board, category: ctx }) }] : [])];
// 답댓글은 위 댓글 아래로
const roots = comments.filter((c) => !c.parent_id || !comments.some((p) => p.id === c.parent_id));
const kids = (id: number) => comments.filter((c) => c.parent_id === id);
const ordered: { c: any; depth: number }[] = [];
const walk = (c: any, depth: number) => {
  ordered.push({ c, depth });
  kids(c.id).forEach((k) => walk(k, depth + 1));
};
roots.forEach((c) => walk(c, 0));
const plain = post.body_html.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim().slice(0, 140);
---

<Base title={`${post.title} · 옛 홈페이지 보관함`} description={plain || undefined} tight>
  <!-- 보관함 제목은 목록과 같은 모양, 이 페이지의 h1 은 글 제목 -->
  <!-- 보관함 제목 배지(누르면 보관함 첫 화면). 이 페이지의 h1 은 글 제목이라 p -->
  <LegacyHead as="p" />
  <div class="lib-split legacy-split">
  <article class="doc legacy lib-main">
    <LegacySubTitle as="div" parts={[{ label: boardName, href: boardHref }]} count={g?.n ?? null} />
    {tabs.length > 0 && (
      <div class="ltabs">
        <SubTabs items={tabs} label={`${boardName} 분류`} />
      </div>
    )}
    <h1 class="post-title">{post.title}</h1>
    <p class="meta">
      {post.category && <span class="pcat">{post.category}</span>}
      {post.author && <span>{post.author}</span>}
      <span>{fmt(post.created_at)}</span>
      <span>조회 {Number(post.hits).toLocaleString("ko-KR")}</span>
    </p>
    <Prose html={post.body_html} />
    {ordered.length > 0 && (
      <section class="comments" aria-label="댓글">
        <h2>댓글 {ordered.length}</h2>
        <ul>
          {ordered.map(({ c, depth }) => (
            <li style={`--d:${Math.min(depth, 4)}`}>
              <div class="who">
                <strong>{c.author}</strong> <span>{fmt(c.created_at)}</span>
              </div>
              <div class="body" set:html={c.body_html} />
            </li>
          ))}
        </ul>
      </section>
    )}
    <!-- 아래 목록 — 글을 연 범위(게시판 전체 또는 그 분류): 날짜(월-일)·분류(전체일 때)·제목·댓글 수·조회수, 지금 글 강조, 쪽 번호 -->
    <section class="blist" id="legacy-list" aria-label={`${crumbs.map((c) => c.label).join(" ")} 목록`}>
      <h2 class="bl-h">
        {crumbs.map((c, i) => (
          <Fragment>
            {i > 0 && <span aria-hidden="true">»</span>} <a href={c.href}>{c.label}</a>
          </Fragment>
        ))}
      </h2>
      <ul>
        {list.items.map((r) => {
          const on = r.board === post.board && r.cid === post.cid;
          return (
            <li class:list={[{ on }]}>
              <a href={legacyHref(r.board, r.cid, ctx || null)} aria-current={on ? "page" : undefined}>
                <span class="d" title={r.created_at}>{md(r.created_at)}</span>
                {!ctx && r.category && <span class="c">{r.category}</span>}
                <span class="t">{r.title}</span>
                {r.comment_count > 0 && (
                  <span class="cm" aria-label={`댓글 ${r.comment_count}`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v12H8l-4 4V4z" /></svg>
                    {r.comment_count}
                  </span>
                )}
                <span class="h" aria-label={`조회 ${r.hits}`}>{Number(r.hits).toLocaleString("ko-KR")}</span>
              </a>
            </li>
          );
        })}
      </ul>
      {list.pages > 1 && (
        <nav class="bl-pages" aria-label="목록 쪽">
          {Array.from({ length: list.pages }, (_, i) => i + 1)
            .filter((n) => n === 1 || n === list.pages || Math.abs(n - list.page) <= 3)
            .map((n, i, arr) => (
              <Fragment>
                {i > 0 && n - arr[i - 1] > 1 && <span class="gap">…</span>}
                {n === list.page ? (
                  <span class="cur" aria-current="page">{n}</span>
                ) : (
                  <a href={lpHref(n)}>{n}</a>
                )}
              </Fragment>
            ))}
        </nav>
      )}
    </section>
  </article>
  <LegacySide groups={groups} board={post.board} category={ctx} />
  </div>
</Base>

<style>
  /* 게시판 제목 아래 분류 탭 — 목록과 같은 자리·간격 */
  .ltabs {
    margin: 12px 0 8px;
  }
  /* 글의 분류 — 목록 줄의 분류 꼬리표와 같은 모양 */
  .pcat {
    padding: 1px 7px;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .legacy-split {
    margin-top: 0;
  }
  .post-title {
    margin: 18px 0 8px;
    font-size: 1.4rem;
    line-height: 1.35;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    margin: 0 0 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .legacy :global(.prose img) {
    max-width: 100%;
    height: auto;
  }
  .legacy :global(.prose iframe) {
    max-width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
  }
  .comments {
    margin-top: 32px;
    border-top: 1px solid var(--color-rule);
    padding-top: 16px;
  }
  .comments h2 {
    font-size: 1rem;
    margin: 0 0 10px;
  }
  .comments ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .comments li {
    margin-left: calc(var(--d) * 22px);
    padding: 10px 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .comments .who {
    font-size: 0.88rem;
    margin-bottom: 4px;
  }
  .comments .who span {
    color: var(--color-muted);
    margin-left: 6px;
  }
  .comments .body {
    font-size: 0.95rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  /* 아래 목록 (옛 사이트 목록 모양) */
  .blist {
    margin-top: 40px;
    scroll-margin-top: calc(var(--header-h, 64px) + 12px);
  }
  .bl-h {
    margin: 0 0 6px;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .bl-h a {
    color: inherit;
  }
  .bl-h span {
    margin: 0 6px;
    color: var(--color-muted);
  }
  .blist ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--color-fg);
  }
  .blist li {
    border-bottom: 1px solid var(--color-rule);
  }
  .blist li a {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 6px 6px;
    color: var(--color-ink);
    font-size: 0.93rem;
  }
  .blist li a:hover {
    background: var(--color-surface-2);
    text-decoration: none;
  }
  .blist li a:hover .t {
    color: var(--color-primary);
  }
  .blist li.on a {
    background: var(--color-primary-bg);
  }
  .blist li.on .t {
    font-weight: 700;
    color: var(--color-primary);
  }
  .blist .d {
    flex: none;
    width: 3.2em;
    color: var(--color-secondary, var(--color-muted));
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .blist .c {
    flex: none;
    padding: 2px 6px;
    border-radius: 3px;
    background: var(--color-muted);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .blist .t {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .blist .cm {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--color-secondary, var(--color-primary));
    font-size: 0.8rem;
    font-weight: 700;
  }
  .blist .cm svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
  .blist .h {
    flex: none;
    min-width: 3.4em;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-rule);
    color: var(--color-muted);
    font-size: 0.72rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .bl-pages {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 14px 0 0;
  }
  .bl-pages a,
  .bl-pages span {
    min-width: 32px;
    padding: 4px 8px;
    text-align: center;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
  }
  .bl-pages a {
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }
  .bl-pages a:hover {
    border-color: var(--color-primary);
    text-decoration: none;
  }
  .bl-pages .cur {
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
  }
  .bl-pages .gap {
    color: var(--color-muted);
  }
  @media (max-width: 480px) {
    .blist .c {
      display: none;
    }
  }
</style>
