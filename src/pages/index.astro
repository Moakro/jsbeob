<style>
  .hero {
    position: relative;
    z-index: 2;
    isolation: isolate;
    margin-top: calc(-1 * var(--header-h));
    height: clamp(300px, 70vw, 460px);
    display: flex;
    align-items: flex-end;
    background: #1b1714;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    container-type: size;
    background: #1b1714 var(--poster-sm) center / cover no-repeat;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, #0e0b098c, #0e0b0900 26% 58%, #0e0b099e);
  }
  .hero-media :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, 177.78cqh);
    height: max(100cqh, 56.25cqw);
    transform: translate(-50%, -50%);
    border: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .hero-media :global(iframe.is-playing) {
    opacity: 1;
  }
  .hero-search-wrap {
    position: absolute;
    inset: var(--header-h) 0 56px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    padding-inline: 20px;
    pointer-events: none;
  }
  .hero-search-row {
    pointer-events: auto;
    width: min(812px, 100%);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero-ai {
    flex: none;
    width: 60px;
    height: 60px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    color: #fff;
    background-image: linear-gradient(
      135deg,
      var(--color-primary-deep) 0%,
      var(--color-primary) 38%,
      var(--color-primary-soft) 68%,
      var(--color-primary-deep) 100%
    );
    background-size: 220% 220%;
    background-position: 0% 50%;
    box-shadow:
      0 10px 26px -8px #7e241ca6,
      0 6px 18px -6px #a8352a73,
      inset 0 0 0 1px #ffffff24;
    animation: hero-ai-shift 6s ease-in-out infinite;
    transition:
      filter 0.18s ease,
      transform 0.12s ease;
  }
  .hero-ai:hover {
    filter: brightness(1.14);
  }
  .hero-ai:active {
    transform: scale(0.94);
  }
  .hero-ai svg {
    width: 30px;
    height: 30px;
    fill: currentColor;
    transition: transform 0.18s ease;
  }
  .hero-ai:hover svg {
    transform: scale(1.14);
  }
  .hero-ai:focus-visible {
    outline: 2px solid #f5c84c;
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-ai {
      animation: none;
    }
  }
  @media (max-width: 760px) {
    .hero-search-wrap {
      inset: var(--header-h) 0 64px;
      padding-inline: 16px;
    }
    .hero-search-row {
      gap: 8px;
    }
    .hero-ai {
      width: 54px;
      height: 54px;
    }
    .hero-ai svg {
      width: 27px;
      height: 27px;
    }
  }
  .hero-foot {
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 22px;
  }
  .hero-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }
  .hero-title-kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #f5c84c;
  }
  .hero-title strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.4rem);
  }
  .hero-title small {
    font-size: 0.82rem;
    color: #ffffffc7;
  }
  .hero-title small[hidden] {
    display: none;
  }
  .hero-toggle {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: #0e0b0959;
    backdrop-filter: blur(6px);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .hero-toggle:hover {
    background: #0e0b098c;
    border-color: #fff;
  }
  .hero-toggle[hidden] {
