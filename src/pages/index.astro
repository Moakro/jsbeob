---
// import 순서는 배포본 서버 번들의 모듈 실행 순서를 따랐다 — Astro 가 이 순서로 페이지 CSS <link> 순서를 정한다.
import Base from "../layouts/Base.astro";
import HeroSearch from "../components/HeroSearch.svelte";
import Thumb from "../components/Thumb.astro";
import VideoCard from "../components/media/VideoCard.astro";
import UpcomingDays from "../components/home/UpcomingDays.svelte";
import HomeMiniMap from "../components/home/HomeMiniMap.svelte";
import FeedRows from "../components/home/FeedRows.astro";
import NewsModal from "../components/board/NewsModal.svelte";
import NewsRows from "../components/board/NewsRows.astro";
import { SHOW_AI_CHAT } from "../data/site-nav";
import {
  getHomeHero,
  listHomeTiles,
  listMapPoints,
  listRecentNews,
  listRecentOrialter,
  listVideos,
} from "../lib/content";
const HERO_VIDEOS = [
  {
    id: "vATQ6bAp2Xw",
    title: "오리알터 드론영상 — 옛날 천하전",
    caption: "2019.05.11 촬영",
  },
];
export const prerender = false;
const [{ videos }, tiles, news, feed, map, heroPhoto] = await Promise.all([
  listVideos(Astro.request),
  listHomeTiles(Astro.request),
  listRecentNews(Astro.request, 4),
  listRecentOrialter(Astro.request, 5),
  listMapPoints(Astro.request).catch(() => ({ points: [], tags: [] })),
  getHomeHero(Astro.request),
]);
const firstTag = map.tags[0] ?? null;
const mapPoints = (firstTag ? map.points.filter((p) => firstTag.members.includes(p.id)) : map.points).map(
  (p) => ({ lat: p.lat, lng: p.lng }),
);
const mapHref = firstTag ? `/map/?tag=${encodeURIComponent(firstTag.slug)}` : "/map/";
const mapLabel = firstTag ? `${firstTag.name} ${mapPoints.length}곳` : `장소 ${mapPoints.length}곳`;
const firstVideo = HERO_VIDEOS[0];
const posterSm = heroPhoto ? `url(${JSON.stringify(heroPhoto.url)})` : `url(/hero/${firstVideo.id}-960.webp)`;
---

<Base bleed overlayHeader>
  <section class:list={["hero", [{ "has-photo": !!heroPhoto }]]} data-hero>
    <div
      class="hero-media"
      data-videos={JSON.stringify(HERO_VIDEOS)}
      style={`--poster:url(/hero/${firstVideo.id}.webp);--poster-sm:${posterSm}`}
      aria-hidden="true"
    ></div>
    <div class="hero-shade" aria-hidden="true"></div>
    <!-- 화면엔 안 보이지만 검색엔진·스크린리더용 페이지 제목은 유지 -->
    <h1 class="sr-only">증산법종교 공식 홈페이지</h1>
    <!-- ── 히어로 중앙 검색 (Pagefind 결과 패널 · 모바일 음성 입력) + AI 대화 버튼(우측 드로어) ── -->
    <div class="hero-search-wrap">
      <div class="hero-search-row">
        <!-- 검색폼 + 결과 패널(jsbooks 방식) — src/components/HeroSearch.svelte -->{" "}
        <HeroSearch client:load />{" "}
        <!-- AI 대화 — 검색폼 바깥 우측, solomad 트리거와 같은 원형 아이콘 버튼. 클릭하면 우측 드로어(AiChatDrawer).
             SHOW_AI_CHAT 으로 켜고 끈다 (2026-11-13 숨김) -->{" "}
        {SHOW_AI_CHAT && (
          <button
            type="button"
            class="hero-ai"
            data-ai-open
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-label="AI 대화 열기"
            title="AI 대화"
          >
            <!-- Material Symbols Outlined "auto_awesome" (구글 공식 SVG) -->{" "}
            <svg viewBox="0 -960 960 960" aria-hidden="true">
              <path d="m760-600-50-110-110-50 110-50 50-110 50 110 110 50-110 50-50 110Zm0 560-50-110-110-50 110-50 50-110 50 110 110 50-110 50-50 110ZM360-160 260-380 40-480l220-100 100-220 100 220 220 100-220 100-100 220Zm0-194 40-86 86-40-86-40-40-86-40 86-86 40 86 40 40 86Zm0-126Z"></path>
            </svg>
          </button>
        )}
      </div>
    </div>
    <div class="container hero-foot">
      <p class="hero-title" aria-live="polite">
        <span class="hero-title-kicker">영상</span> <strong data-hero-title>{firstVideo.title}</strong>{" "}
        <small data-hero-caption hidden={!firstVideo.caption}>
          {firstVideo.caption}
        </small>
      </p>
      {heroPhoto?.caption && (
        <p class="hero-title hero-photo-title">
          {" "}
          <strong>{heroPhoto.caption}</strong>{" "}
        </p>
      )}
      <div class="hero-ctrl">
        <!-- 멈춤 직후 뜨는 확인 말풍선: 이번 방문(탭) 동안 계속 멈춰둘지 -->
        <div class="hero-ask" data-hero-ask role="dialog" aria-label="배경 영상 멈춤 유지" hidden>
          <p>사이트를 보는 동안 계속 멈춰둘까요?</p>
          <div class="hero-ask-btns">
            <button type="button" data-ask-choice="keep">
              계속 멈춤
            </button>{" "}
            <button type="button" data-ask-choice="once">
              이번만
            </button>
          </div>
        </div>
        <button type="button" class="hero-toggle" data-hero-toggle hidden aria-label="배경 영상 일시정지">
          <span class="ico-pause" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </section>
  <div class="container home-body">
    <div class="home-split">
      <div class="home-main">
        <!-- 법종교 미디어(가칭) — 유튜브 채널 최신 영상. 누르면 미리보기 모달(VideoPreview) -->{" "}
        {videos.length > 0 && (
          <section class="block">
            {" "}
            <div class="section-head">
              {" "}
              <span class="kicker">미디어</span> <h2>법종교 미디어</h2>{" "}
              <a class="more" href="/media/">
                전체 보기 →
              </a>{" "}
            </div>{" "}
            <VideoCard video={videos[0]} size="lg" />{" "}
            {videos.length > 1 && (
              <div class="media-row">
                {" "}
                {videos.slice(1, 4).map((v) => (
                  <VideoCard video={v} />
                ))}{" "}
              </div>
            )}{" "}
            {videos.length > 2 && (
              <div class="media-dots">
                {" "}
                {videos.slice(1, 4).map((v, i) => (
                  <button
                    type="button"
                    class:list={[{ on: i === 0 }]}
                    aria-label={`${i + 1}번째 영상: ${v.title}`}
                    data-dot={i}
                  ></button>
                ))}{" "}
              </div>
            )}{" "}
          </section>
        )}{" "}
        <!-- 둘러보기 — 섹션 내용 목록 대신 테마 입구 카드만(사장 결정). 카드 목록은 사이트 관리 → 홈 편성 -->{" "}
        {tiles.length > 0 && (
          <section class="block">
            {" "}
            <div class="section-head">
              {" "}
              <span class="kicker">둘러보기</span> <h2>증산법종교 둘러보기</h2>{" "}
            </div>{" "}
            <div class="tiles">
              {" "}
              {tiles.map((t) => (
                <a class="tile" href={t.href}>
                  {" "}
                  <Thumb
                    src={t.image?.url}
                    glyph={t.glyph ?? t.title}
                    alt={t.image?.alt ?? t.title}
                    seed={t.id}
                    ratio="16 / 9"
                  />{" "}
                  <span class="tile-body">
                    {" "}
                    <strong>{t.title}</strong> {t.subtitle && <small>{t.subtitle}</small>}{" "}
                  </span>{" "}
                  {t.count != null && t.count > 0 && (
                    <span class="tile-count">
                      {" "}
                      {t.count} {t.count_unit ?? ""}{" "}
                    </span>
                  )}{" "}
                </a>
              ))}{" "}
            </div>{" "}
          </section>
        )}
      </div>
      <aside class="home-side" aria-label="소식과 안내">
        <div class="side-slot side-upcoming">
          <UpcomingDays client:visible />
        </div>
        {news.length > 0 && (
          <section class="side-box">
            {" "}
            <div class="side-head">
              {" "}
              <h3>공지·일정·소식</h3>{" "}
              <a href="/community/#news" data-news-all>
                전체 보기 →
              </a>{" "}
            </div>{" "}
            <NewsRows news={news} />{" "}
          </section>
        )}{" "}
        {feed.length > 0 && (
          <section class="side-box side-feed">
            {" "}
            <div class="side-head">
              {" "}
              <h3>도생광장</h3>{" "}
              <a class="box-link" href="/community/">
                이동하기 →
              </a>{" "}
            </div>{" "}
            <FeedRows posts={feed} />{" "}
          </section>
        )}{" "}
        {mapPoints.length > 0 && (
          <div class="side-slot">
            {" "}
            <HomeMiniMap
              client:visible
              points={mapPoints}
              href={mapHref}
              label={mapLabel}
              color={firstTag?.color ?? void 0}
            />{" "}
          </div>
        )}
      </aside>
    </div>
  </div>
  {news.length > 0 && <NewsModal client:load />}
</Base>{" "}
<script>
  // 복원: 배포본 번들(압축)에서 되살린 스크립트 — 변수 이름은 압축 결과 그대로다.
  import { confirmDialog as J } from "../lib/confirm";
  globalThis.process ??= {};
  globalThis.process.env ??= {};
  document.querySelectorAll("[data-feed-id]").forEach((e) =>
    e.addEventListener("click", async (t) => {
      t.metaKey ||
        t.ctrlKey ||
        t.shiftKey ||
        t.button !== 0 ||
        (t.preventDefault(),
        (await J({
          title: "페이지 이동",
          message: "도생광장으로 이동해 이 글을 볼까요?",
          confirmText: "이동",
        })) && (location.href = e.href));
    }),
  );
  document.querySelectorAll("[data-news-id]").forEach((e) =>
    e.addEventListener("click", (t) => {
      t.metaKey ||
        t.ctrlKey ||
        t.shiftKey ||
        t.button !== 0 ||
        (t.preventDefault(),
        window.dispatchEvent(new CustomEvent("jb:news-open", { detail: { id: e.dataset.newsId } })));
    }),
  );
  document.querySelectorAll("[data-news-all]").forEach((e) =>
    e.addEventListener("click", (t) => {
      t.metaKey ||
        t.ctrlKey ||
        t.shiftKey ||
        t.button !== 0 ||
        (t.preventDefault(), window.dispatchEvent(new CustomEvent("jb:news-open", { detail: {} })));
    }),
  );
  {
    const e = document.querySelector(".media-row"),
      t = [...document.querySelectorAll(".media-dots button")];
    if (e && t.length) {
      const l = () => [...e.children],
        f = () => {
          const s = l();
          if (e.scrollLeft + e.clientWidth >= e.scrollWidth - 4) return s.length - 1;
          let a = 0,
            i = 1 / 0;
          return (
            s.forEach((r, m) => {
              const c = Math.abs(r.offsetLeft - s[0].offsetLeft - e.scrollLeft);
              c < i && ((i = c), (a = m));
            }),
            a
          );
        };
      let d = 0;
      (e.addEventListener(
        "scroll",
        () => {
          d ||
            (d = requestAnimationFrame(() => {
              d = 0;
              const s = f();
              t.forEach((a, i) => a.classList.toggle("on", i === s));
            }));
