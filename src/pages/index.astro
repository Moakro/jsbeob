  }
  function q() {
    if (!h || !w.length || !I.matches || n) return;
    const e = w.map((r) => r.id),
      t = _(),
      l = t ? Math.max(0, e.indexOf(t.id)) : 0,
      f = [...e.slice(l), ...e.slice(0, l)],
      d = t ? Math.max(0, Math.floor(t.t) - 1) : 0;
    ((p = f[0]), (v = d), x(f[0]), h.classList.toggle("is-resuming", d > 0));
    const s = new URLSearchParams({
      autoplay: "1",
      mute: "1",
      loop: "1",
      playlist: f.join(","),
      start: String(d),
      controls: "0",
      playsinline: "1",
      rel: "0",
      disablekb: "1",
      iv_load_policy: "3",
      enablejsapi: "1",
      origin: location.origin,
    });
    ((n = document.createElement("iframe")),
      (n.src = `${g}/embed/${f[0]}?${s}`),
      (n.title = "증산법종교 배경 영상"),
      (n.allow = "autoplay; encrypted-media; picture-in-picture"),
      (n.tabIndex = -1),
      n.setAttribute("aria-hidden", "true"));
    let a = 0;
    const i = window.setInterval(() => {
