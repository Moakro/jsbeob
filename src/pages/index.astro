        { passive: !0 },
      ),
        t.forEach((s, a) =>
          s.addEventListener("click", () => {
            const i = l();
            e.scrollTo({
              left: i[a].offsetLeft - i[0].offsetLeft,
              behavior: "smooth",
            });
          }),
        ));
    }
  }
  const h = document.querySelector(".hero-media[data-videos]"),
    K = document.querySelector("[data-hero-title]"),
    E = document.querySelector("[data-hero-caption]"),
    o = document.querySelector("[data-hero-toggle]"),
    w = h ? JSON.parse(h.dataset.videos || "[]") : [],
    I = window.matchMedia("(min-width: 861px) and (prefers-reduced-motion: no-preference)"),
    g = "https://www.youtube-nocookie.com";
  let n = null,
    D = !1;
  const M = "jb-hero-pos";
  let p = "",
    v = 0,
    O = 0;
  function _() {
    try {
      const e = JSON.parse(sessionStorage.getItem(M) || "null");
      if (e && typeof e.t == "number" && w.some((t) => t.id === e.id)) return e;
    } catch {}
    return null;
  }
  function T(e = !1) {
    if (!p) return;
    const t = Date.now();
    if (!(!e && t - O < 1e3)) {
      O = t;
      try {
        sessionStorage.setItem(M, JSON.stringify({ id: p, t: v }));
      } catch {}
    }
  }
  window.addEventListener("pagehide", () => T(!0));
  document.addEventListener("visibilitychange", () => {
    document.visibilityState === "hidden" && T(!0);
  });
  function x(e) {
    const t = w.find((l) => l.id === e);
    !t ||
      !K ||
      ((K.textContent = t.title), E && ((E.textContent = t.caption ?? ""), (E.hidden = !t.caption)));
  }
  function A(e) {
    n?.contentWindow?.postMessage(JSON.stringify({ event: "command", func: e, args: [] }), g);
  }
