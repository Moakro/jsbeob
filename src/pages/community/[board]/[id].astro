---
import Base from "../../../layouts/Base.astro";
import { BOARDS, postHref } from "../../../lib/api";
import PostView from "../../../components/board/PostView.svelte";
import CommunityHome from "../../../components/community/CommunityHome.astro";
import { getBoardConfig, getPostMeta } from "../../../lib/content";
export const prerender = false;
const { board, id } = Astro.params;
const known = BOARDS[board];
if (known?.base) return Astro.redirect(postHref(board, id), 301);
// 관리 화면에서 만든 게시판(2026-11-16)은 설정에서 이름을 가져온다
const cfg = known ? null : await getBoardConfig(Astro.request, board).catch(() => null);
if (!known && !cfg) return Astro.redirect("/community/");
const meta = { label: (cfg?.label ?? known?.label) as string };
const asModal = board === "orialter" || board === "news";
// 공유 미리보기 — 팝업으로 여는 게시판 글도 그 글의 제목·요약·첫 사진으로 (2026-11-21)
const og = asModal ? await getPostMeta(Astro.request, id as string) : null;
const boardLabel = board === "news" ? "소식" : "오리알터";
---

{asModal ? (
  board === "news" ? (
    <CommunityHome
      newsOpenId={id}
      title={og?.title ? `${og.title} · 소식` : "소식 · 도생광장"}
      description={og?.description ?? undefined}
      image={og?.image ?? undefined}
      ogType="article"
    />
  ) : (
    <CommunityHome
      openId={id}
      title={og?.title ? `${og.title} · ${boardLabel}` : "오리알터 · 도생광장"}
      description={og?.description ? `${og.author ? `${og.author} · ` : ""}${og.description}` : undefined}
      image={og?.image ?? undefined}
      ogType="article"
    />
  )
) : (
  <Base title={meta.label} tight>
    <div class="board-wrap">
      <PostView client:load board={board} id={id} crumbs={false} />
    </div>
  </Base>
)}

<style>
  .board-wrap {
    margin-top: 0;
  }
</style>
