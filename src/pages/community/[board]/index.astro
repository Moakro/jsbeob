---
// 복원(2026-11-01): 프리렌더 페이지라 서버 번들에 코드가 없다 — 배포본 HTML(/community/help/)과 9월 버전을 근거로 다시 썼다.
// 오리알터·소식은 도생광장(/community/) 탭으로, 기타 자료는 자료실로 옮겨 astro.config 의 redirects 가 처리한다.
import Base from "../../../layouts/Base.astro";
import PageTitle from "../../../components/content/PageTitle.astro";
import Board from "../../../components/board/Board.svelte";
import { BOARDS } from "../../../lib/api";
import { KAKAO_CHANNEL_URL } from "../../../data/site-nav";
import { getBoardConfig } from "../../../lib/content";

// 2026-11-16: 관리 화면에서 만든 게시판도 열리게 요청 때 그린다(게시판 설정은 DB boards).
export const prerender = false;
const { board } = Astro.params;
const known = BOARDS[board as string];
// 도생광장 탭·자료실 게시판은 제자리로
if (known?.tab) return Astro.redirect("/community/");
if (known?.base) return Astro.redirect(`${known.base}/`, 301);
const cfg = await getBoardConfig(Astro.request, board as string).catch(() => null);
if (!cfg || cfg.storage !== "post" || cfg.view !== "list") return new Response(null, { status: 404 });
const meta = { label: cfg.label as string, desc: (cfg.description as string) || (known?.desc ?? "") };
---

<Base title={meta.label} description={meta.desc} tight>
  <PageTitle title={meta.label}>
    {board === "help" && KAKAO_CHANNEL_URL && (
      <a class="kakao" href={KAKAO_CHANNEL_URL} target="_blank" rel="noopener">
        카카오톡 채널로 문의 →
      </a>
    )}
  </PageTitle>
  <div class="board-wrap">
    <Board client:load board={board as string} />
  </div>
</Base>

<style>
  .board-wrap {
    margin-top: 0;
  }
  .kakao {
    margin-left: auto;
    font-size: 0.88rem;
    font-weight: 600;
  }
</style>
