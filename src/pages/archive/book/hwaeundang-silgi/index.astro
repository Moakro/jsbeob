---
// 복원(2026-11-01): 프리렌더 페이지라 서버 번들에 코드가 없다 — 배포본 HTML 과 9월 버전
// (src/pages/archive/hwaeundang-silgi/index.astro)을 근거로 다시 썼다.
import Base from "../../../../layouts/Base.astro";
import ArchiveTabs from "../../../../components/content/ArchiveTabs.astro";
import PageTitle from "../../../../components/content/PageTitle.astro";
import { getHwaeundang, chapterSlug, chapterLabel } from "../../../../lib/hwaeundang";

const chapters = await getHwaeundang();
---

<Base title="화은당실기" description="화은당실기(華恩堂實記) — 화은당 선사님의 생애와 법종교 연혁" tight>
  <ArchiveTabs current="book" />
  <PageTitle title="화은당실기" hanja="華恩堂實記" />
  <article class="doc">
    <ol class="toc">
      {chapters.map((c) => (
        <li>
          <a href={`/archive/book/hwaeundang-silgi/${chapterSlug(c)}/`}>
            <span class="label">{chapterLabel(c)}</span>
            {c.data.장_이름 && <span class="name">{c.data.장_이름}</span>}
          </a>
        </li>
      ))}
    </ol>
  </article>
</Base>

<style>
  .doc {
    max-width: 760px;
  }
  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .toc a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    color: var(--color-ink);
    border: 1px solid transparent;
  }
  .toc a:hover {
    background: var(--color-surface);
    border-color: var(--color-rule);
    text-decoration: none;
  }
  .toc .label {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-primary);
    min-width: 4em;
  }
  .toc .name {
    font-size: 1.05rem;
  }
</style>
