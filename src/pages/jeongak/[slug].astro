---
import Base from "../../layouts/Base.astro";
import { getPlace, listPlaces } from "../../lib/content";
import AdminEditLink from "../../components/content/AdminEditLink.astro";
import ContentGallery from "../../components/content/ContentGallery.astro";
import DocPager from "../../components/content/DocPager.astro";
import LeadImage from "../../components/content/LeadImage.astro";
import PageTitle from "../../components/content/PageTitle.astro";
import PreviewNotice from "../../components/content/PreviewNotice.astro";
import Prose from "../../components/content/Prose.astro";
import SideList from "../../components/content/SideList.astro";
export const prerender = false;
const preview = Astro.url.searchParams.get("preview") === "1";
const [place, allJeongak] = await Promise.all([
  getPlace(Astro.request, Astro.params.slug, preview),
  listPlaces(Astro.request, "jeongak").catch(() => []),
]);
if (!place || place.kind !== "jeongak") {
  if (place) return Astro.redirect(`/archive/places/${place.slug}/${preview ? "?preview=1" : ""}`);
  return new Response("페이지를 찾을 수 없습니다.", {
    status: 404,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  });
}
const { name, name_hanja, summary, built, hero, gallery = [], body_html = "", status, id } = place;
const lead = hero ?? gallery[0] ?? null;
const rest = hero ? gallery : gallery.slice(1);
const side = allJeongak.map((j) => ({
  key: j.slug,
  title: j.name,
  hanja: j.name_hanja,
  href: `/jeongak/${j.slug}/`,
  on: j.slug === place.slug,
  draft: j.status === "draft",
}));
if (side.length && !side.some((s) => s.on))
  side.unshift({
    key: place.slug,
    title: name,
    hanja: name_hanja,
    href: `/jeongak/${place.slug}/`,
    on: true,
  });
const at = side.findIndex((s) => s.on);
const prev = at > 0 ? { href: side[at - 1].href, label: side[at - 1].title } : null;
const next = at >= 0 && at < side.length - 1 ? { href: side[at + 1].href, label: side[at + 1].title } : null;
const split = side.length > 1;
---

<Base title={name} description={summary ?? void 0} tight>
  {" "}
  <PreviewNotice status={status} editHref={`/admin/#place/${id}`} />{" "}
  {status === "published" && (
    <div hidden data-page-feed data-kind="place" data-id={id} data-title={name}></div>
  )}
  <div class:list={[{ "doc-split": split }]}>
    <div class="doc-main">
      <article class="doc">
        <PageTitle title={name} hanja={name_hanja} sub={built ? `건립 ${built}` : null}>
          <AdminEditLink href={`/admin/#place/${id}`} inline />
        </PageTitle>{" "}
        {summary && <p class="summary">{summary}</p>}{" "}
        <LeadImage image={lead} alt={name} /> <Prose html={body_html} />{" "}
        <ContentGallery items={rest} fallbackAlt={name} />
      </article>
    </div>
    {split && <SideList label="전각 목록" items={side} />}
  </div>
  {split && <DocPager prev={prev} next={next} />}
</Base>

<style>
  .doc {
    max-width: 760px;
  }
  .summary {
    margin: 0 0 1.4em;
    color: var(--color-muted);
  }
</style>
