---
import Base from "../../layouts/Base.astro";
import { listPlaces } from "../../lib/content";
import Thumb from "../../components/Thumb.astro";
import DraftBadge from "../../components/content/DraftBadge.astro";
export const prerender = false;
const jeongak = await listPlaces(Astro.request, "jeongak");
---

<Base title="전각 안내" description="증산법종교 성지에 자리한 전각들의 유래와 의미, 위치를 안내합니다." tight>
  <h1 class="sr-only">전각 안내</h1>
  <div class="wz-grid cols-3">
    {jeongak.map((j) => (
      <a class="wz-card" href={`/jeongak/${j.slug}/`}>
        {" "}
        <Thumb
          src={j.thumb?.url}
          glyph={j.name_hanja ?? j.name}
          alt={j.thumb?.alt ?? j.name}
          seed={j.slug}
          ratio="4 / 3"
          crop={j.thumb?.crop}
        />{" "}
        <div class="body">
          {" "}
          <h3>
            {" "}
            {j.name} {j.name_hanja && <span class="hanja"> {j.name_hanja}</span>}{" "}
            {j.status === "draft" && <DraftBadge />}{" "}
          </h3>{" "}
          {j.summary && <p>{j.summary}</p>}{" "}
        </div>{" "}
      </a>
    ))}
  </div>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .hanja {
    color: var(--color-muted);
    font-weight: 500;
    font-size: 0.82em;
  }
</style>
