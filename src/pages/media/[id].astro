---
import Base from "../../layouts/Base.astro";
import { listVideos } from "../../lib/content";
import VideoCard from "../../components/media/VideoCard.astro";
export const prerender = false;
const id = Astro.params.id ?? "";
if (!/^[\w-]{11}$/.test(id)) return new Response("not found", { status: 404 });
const { videos, hiddenIds } = await listVideos(Astro.request);
if (hiddenIds.includes(id)) return new Response("not found", { status: 404 });
const v = videos.find((x) => x.id === id) ?? null;
const others = videos.filter((x) => x.id !== id).slice(0, 6);
const title = v?.title ?? "영상";
const d = v ? new Date(v.published) : null;
const date =
  d && !Number.isNaN(d.getTime())
    ? `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`
    : "";
---

<Base
  title={`${title} · 법종교 미디어`}
  description={v?.description?.slice(0, 120) || "증산법종교 유튜브 영상"}
  tight
>
  <article class="vd">
    <div class="frame">
      <iframe
        src={`https://www.youtube.com/embed/${id}?rel=0`}
        title={title}
        allow="encrypted-media; picture-in-picture; fullscreen"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    <h1>{title}</h1>
    <p class="meta">
      {[date, v?.views != null ? `조회 ${v.views.toLocaleString("ko-KR")}` : ""].filter(Boolean).join(" · ")}{" "}
      <a href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">
        유튜브에서 보기 ↗
      </a>
    </p>
    {v?.description && <div class="desc">{v.description}</div>}
  </article>
  {others.length > 0 && (
    <section class="block">
      {" "}
      <div class="section-head">
        {" "}
        <h2>다른 영상</h2>{" "}
        <a class="more" href="/media/">
          전체 보기 →
        </a>{" "}
      </div>{" "}
      <div class="grid">
        {" "}
        {others.map((o) => (
          <VideoCard video={o} />
        ))}{" "}
      </div>{" "}
    </section>
  )}
</Base>

<style>
  .vd {
    max-width: 960px;
    margin: 0 0 40px;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000;
  }
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  h1 {
    margin: 18px 0 6px;
    font-size: 1.5rem;
    line-height: 1.4;
  }
  .meta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 16px;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .meta a {
    font-weight: 600;
  }
  .desc {
    white-space: pre-line;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
    line-height: 1.8;
  }
  @media (max-width: 760px) {
    .frame {
      margin-inline: calc(-1 * var(--gutter));
      border-radius: 0;
    }
    .desc {
      margin-inline: calc(-1 * var(--gutter));
      border-radius: 0;
      padding-inline: var(--gutter);
    }
    .grid :global(.vc-thumb) {
      margin-inline: calc(-1 * var(--gutter));
      border-radius: 0;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px 18px;
  }
</style>
