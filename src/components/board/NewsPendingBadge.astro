---
// 소식 게시판 대기(공개 심사 중) 글 수 — '전체 보기' 링크 안 끝에 둔다(누르면 링크와 같은 곳).
// 페이지는 모두에게 같은 HTML 이라 브라우저에서 로그인한 사람에게만 불러와 붙인다. 0 이면 안 보임 (2026-11-28)
---

<span class="news-pending-badge" data-news-pending-badge hidden></span>

<script>
  import { api } from "../../lib/api";
  const els = [...document.querySelectorAll<HTMLElement>("[data-news-pending-badge]")];
  if (els.length)
    api
      .me()
      .then(({ user }) => (user ? api.pendingCount("news") : null))
      .then((r) => {
        if (!r?.pending) return;
        for (const e of els) {
          e.textContent = String(r.pending);
          e.hidden = false;
        }
      })
      .catch(() => {});
</script>

<style>
  /* 관리 화면 신고 탭 배지(AdminApp .tab-badge)와 같은 모양 */
  .news-pending-badge {
    display: inline-block;
    min-width: 18px;
    margin-left: 5px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
  }
  .news-pending-badge[hidden] {
    display: none;
  }
</style>
