---
// 옛 홈페이지 보관함 맨 위 제목 — 흰 바탕 배지, 누르면 보관함 첫 화면(/legacy/)으로 (사용자 지시 2026-11-14)
// as: 목록에서는 h1, 글 보기에서는 h1 이 글 제목이라 p. 아래 얇은 선은 본문+사이드바 전체 폭.
const { as: Tag = "h1" } = Astro.props as { as?: string };
---

<div class="legacy-head">
  <Tag class="lh-title"><a class="lh-badge" href="/legacy/">옛 홈페이지 보관함</a></Tag>
</div>

<style>
  .legacy-head {
    margin: 0 0 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-rule);
  }
  .lh-title {
    margin: 0;
    font-size: inherit;
    line-height: 1;
  }
  .lh-badge {
    display: inline-flex;
    align-items: center;
    padding: 7px 18px;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px #0000000f;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .lh-badge:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
  }
  .lh-badge:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  @media (max-width: 760px) {
    .legacy-head {
      margin-bottom: 16px;
    }
    .lh-badge {
      padding: 6px 15px;
      font-size: 1.12rem;
    }
  }
</style>
