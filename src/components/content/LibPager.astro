---
import LibRows from "./LibRows.astro";
const { rows, size = 5, label } = Astro.props;
const pages = [];
for (let i = 0; i < rows.length; i += size) pages.push(rows.slice(i, i + size));
const single = pages.length <= 1;
---

{single ? (
  <LibRows rows={rows} />
) : (
  <div class="pager" data-lib-pager>
    <div class="track" role="group" aria-roledescription="넘기는 목록" aria-label={label} tabindex="0">
      {pages.map((p, i) => (
        <div
          class="page"
          role="group"
          aria-roledescription="쪽"
          aria-label={`${pages.length}쪽 중 ${i + 1}쪽`}
        >
          <LibRows rows={p} />
        </div>
      ))}
    </div>
    <div class="nav">
      <button type="button" class="arrow" data-step="-1" aria-label="이전 쪽" disabled>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M15 6l-6 6 6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <div class="dots">
        {pages.map((_, i) => (
          <button
            type="button"
            class="dot"
            aria-label={`${i + 1}쪽`}
            aria-current={i === 0 ? "true" : void 0}
            data-i={i}
          ></button>
        ))}
      </div>
      <button type="button" class="arrow" data-step="1" aria-label="다음 쪽">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M9 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
)}
<script>
  // 복원: 배포본 번들(압축)에서 되살린 스크립트 — 변수 이름은 압축 결과 그대로다.
  function m(t) {
    if (t.dataset.ready) return;
    t.dataset.ready = "1";
    const r = t.querySelector(".track"),
      a = [...t.querySelectorAll(".dot")],
      [n, s] = [...t.querySelectorAll(".arrow")],
      l = () => Math.round(r.scrollLeft / Math.max(1, r.clientWidth)),
      o = (e) =>
        r.scrollTo({
          left: Math.max(0, Math.min(a.length - 1, e)) * r.clientWidth,
          behavior: "smooth",
        });
    let i = 0;
    const d = () => {
      i = 0;
      const e = l();
      (a.forEach((c, h) =>
        h === e ? c.setAttribute("aria-current", "true") : c.removeAttribute("aria-current"),
      ),
        (n.disabled = e <= 0),
        (s.disabled = e >= a.length - 1));
    };
    (r.addEventListener("scroll", () => (i ||= requestAnimationFrame(d)), {
      passive: !0,
    }),
      a.forEach((e, c) => e.addEventListener("click", () => o(c))),
      [n, s].forEach((e) => e.addEventListener("click", () => o(l() + Number(e.dataset.step)))),
      d());
  }
  const u = () => document.querySelectorAll("[data-lib-pager]").forEach(m);
  u();
  document.addEventListener("astro:page-load", u);
</script>

<style>
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    outline-offset: 2px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .page {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .page :global(.rows) :global(li:last-child) {
    border-bottom: 0;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding-top: 4px;
  }
  .dots {
    display: flex;
    justify-content: center;
    gap: 2px;
  }
  .arrow {
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .arrow:hover:not(:disabled) {
    background: var(--color-bg);
    color: var(--color-primary);
  }
  .arrow:disabled {
    color: var(--color-faint);
    opacity: 0.45;
    cursor: default;
  }
  .dot {
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .dot:before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-faint);
    transition:
      width 0.2s,
      background 0.2s;
  }
  .dot[aria-current="true"]:before {
    width: 16px;
    background: var(--color-primary);
  }
</style>
