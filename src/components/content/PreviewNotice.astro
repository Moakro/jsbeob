---
const { status, editHref } = Astro.props;
---

{status !== "published" && (
  <div class="preview-notice container" role="status">
    {status === "draft" ? (
      <Fragment>
        이 자료는 <strong>작성 중</strong>이라 운영자에게만 보입니다.
      </Fragment>
    ) : (
      <Fragment>
        미리보기 — 이 자료는 <strong>숨김</strong> 상태라 사이트에서 내려가 있습니다.
      </Fragment>
    )}
    {editHref && <a href={editHref}>편집으로 돌아가기</a>}
  </div>
)}

<style>
  .preview-notice {
    margin: 0 auto 20px;
    padding: 10px 14px;
    border: 1px dashed var(--color-gold-soft, #c9a24a);
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    font-size: 0.9rem;
  }
  .preview-notice a {
    margin-left: 8px;
  }
</style>
