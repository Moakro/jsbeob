---
// 이전·다음 글 — 화면에 직접 그리지 않고 데이터만 남긴다 (2026-11-21).
// 좁은 화면의 아래 막대(RefDrawer 의 dock)가 이 값을 읽어 ‹ › 와 '목록'·'자료' 버튼을 한 줄로 그린다.
// 넓은 화면은 옆 목록(SideList)이 있어 따로 보이지 않는다(예전과 같음).
const { prev = null, next = null } = Astro.props;
---

<div
  hidden
  data-doc-pager
  data-prev-href={prev?.href}
  data-prev-label={prev?.label}
  data-next-href={next?.href}
  data-next-label={next?.label}
>
</div>
