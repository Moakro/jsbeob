---
// label: 기본 "작성 중" — 소개 메인은 "비공개" (2026-11-20)
const { label = "작성 중" } = Astro.props;
---

<span class="draft-badge">{label}</span>

<style>
  .draft-badge {
    display: inline-block;
    flex: none;
    margin-left: 6px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--color-primary-bg);
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.5;
    vertical-align: 2px;
    white-space: nowrap;
  }
</style>
