---
const { image, alt = "" } = Astro.props;
---

{image?.url && (
  <figure class="lead">
    <img
      class="m-bleed"
      src={image.url}
      alt={image.alt ?? image.caption ?? alt}
      width={image.width || void 0}
      height={image.height || void 0}
    />
    {(image.caption || (image.license_code && image.credit)) && (
      <figcaption>
        {image.caption}
        {/* 공용 자료실 사진은 출처·라이선스 표기를 그림 바로 아래에 (2026-11-28) */}
        {image.license_code && image.credit && <span class="credit">{image.credit}</span>}
      </figcaption>
    )}
  </figure>
)}

<style>
  .lead {
    margin: 0 0 24px;
  }
  .lead img {
    height: auto;
    border-radius: var(--radius-md);
  }
  @media (min-width: 761px) {
    .lead img {
      width: 100%;
    }
  }
  figcaption {
    margin-top: 6px;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .credit {
    display: block;
    font-size: 0.92em;
    opacity: 0.85;
  }
  @media (max-width: 760px) {
    .lead img {
      border-radius: 0;
    }
  }
</style>
