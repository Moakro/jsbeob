---
// as: 제목 태그(기본 h1). 같은 모양의 구역 제목이 필요하지만 h1은 따로 있을 때 "p" 등으로 바꾼다 (2026-11-12)
// note: 제목 줄 오른쪽 끝에 붙는 작은 표기(예: 연혁의 1937~1997) — 글의 meta.title_note (2026-11-21)
const { title, hanja, parent, sub, note = null, as: Tag = "h1" } = Astro.props;
// 배지 안에서는 바깥 괄호를 뗀다 — '(1937~1997)' → '1937~1997'
const noteText = note ? String(note).replace(/^\s*\((.*)\)\s*$/, "$1") : null;
---

<header class="ptitle">
  {parent && (
    <a class="parent" href={parent.href}>
      {parent.label}
    </a>
  )}
  <Tag class="pt-h">
    {title} {hanja && <span class="hanja">{hanja}</span>}
  </Tag>
  {noteText && <span class="note">{noteText}</span>}
  {sub && <span class="sub">{sub}</span>} <slot />
</header>

<style>
  .ptitle {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 10px;
    row-gap: 4px;
    max-width: 760px;
    margin: 22px 0 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-rule);
  }
  .ptitle:first-child {
    margin-top: 0;
  }
  :global(.subtabs) ~ .ptitle,
  :global(.subtabs) ~ :global(*) .ptitle {
    margin-top: 22px;
  }
  .parent {
    flex-basis: 100%;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .pt-h {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.3;
  }
  .hanja {
    margin-left: 8px;
    color: var(--color-muted);
    font-weight: 400;
    font-size: 0.62em;
  }
  /* 제목 바로 오른쪽 배지 (예: 연혁 기간) */
  .note {
    align-self: center;
    padding: 3px 12px;
    border-radius: 999px;
    /* 상단 분류 탭(주색)과 겹치지 않게 보조색(청록) — 달력·다가오는 날의 기간 배지와 같은 색 */
    background: var(--color-secondary);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .sub {
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  @media (max-width: 760px) {
    .ptitle {
      margin: 18px 0 16px;
    }
    .ptitle:first-child {
      margin-top: 0;
    }
    :global(.subtabs) ~ .ptitle,
    :global(.subtabs) ~ :global(*) .ptitle {
      margin-top: 18px;
    }
    .pt-h {
      font-size: 1.4rem;
    }
  }
</style>
