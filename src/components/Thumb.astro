---
import { cropStyle } from "../lib/crop";
const { src, glyph, alt = "", seed = "", ratio = "16 / 10", crop } = Astro.props;
const PALETTES = [
  ["#a8352a", "#7e241c"],
  // 단심 주홍
  ["#1e6e6e", "#15504f"],
  // 단청 청록
  ["#b8860b", "#8a6508"],
  // 금
  ["#5a4636", "#3a2c22"],
  // 먹/고동
];
let h = 0;
for (const ch of seed) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const [c1, c2] = PALETTES[h % PALETTES.length];
const mark = (glyph ?? alt ?? "").trim().slice(0, 2);
---

{src ? (
  <div class="thumb thumb-img" style={`aspect-ratio:${ratio}`}>
    <img src={src} alt={alt} loading="lazy" style={cropStyle(crop)} />
  </div>
) : (
  <div class="thumb thumb-ph" style={`aspect-ratio:${ratio};--c1:${c1};--c2:${c2}`} aria-hidden="true">
    <span class="glyph">{mark}</span>
  </div>
)}

<style>
  .thumb {
    width: 100%;
    display: block;
  }
  .thumb-img {
    position: relative;
    overflow: hidden;
  }
  .thumb-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-ph {
    position: relative;
    display: grid;
    place-items: center;
    background: radial-gradient(120% 120% at 75% 15%, color-mix(in srgb, var(--c1) 85%, white 0%), var(--c2));
    overflow: hidden;
  }
  .thumb-ph:after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 2px, transparent 2px 9px);
  }
  .glyph {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    color: #ffffffeb;
    letter-spacing: 0.04em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    z-index: 1;
  }
</style>
